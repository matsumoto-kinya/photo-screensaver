<Window x:Class="MyPhotoScreensaver.Windows.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="プレビュー"
        Width="640" Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="Black">
    <Grid Background="Black" ClipToBounds="True">
        <Image x:Name="ImageA"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <Image x:Name="ImageB"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Visibility="Hidden"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock x:Name="NoImagesText"
                   Text="画像フォルダに画像が見つかりません"
                   Foreground="#6C7086"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="14"
                   Visibility="Collapsed"/>
        <!-- Panel mode canvas -->
        <Canvas x:Name="PanelCanvas"
                Background="Black"
                ClipToBounds="True"
                Visibility="Collapsed"/>
    </Grid>
</Window>
