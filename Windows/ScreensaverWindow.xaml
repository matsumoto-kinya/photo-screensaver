<Window x:Class="MyPhotoScreensaver.Windows.ScreensaverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Black"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="None"
        Title="MyPhotoScreensaver">
    <Grid x:Name="RootGrid" Background="Black" ClipToBounds="True">
        <!-- Back layer -->
        <Image x:Name="ImageA"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <!-- Front layer (transitions onto this) -->
        <Image x:Name="ImageB"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Visibility="Hidden"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <!-- Panel mode: multi-image grid canvas -->
        <Canvas x:Name="PanelCanvas"
                Background="Black"
                ClipToBounds="True"
                Visibility="Collapsed"/>
    </Grid>
</Window>
